.DS_Store
/.build
Examples/*/.build
# Per-configuration scratch paths, so that the two halves of the IMAPDispatchClient comparison do not
# rebuild each other every time the path dependency is flipped. See
# Examples/PerformanceTester/dev/compare-dispatch-client.sh.
Examples/*/.build-*
# Where that script checks out its baseline, the pinned `PRE_MIGRATION_COMMIT`.
/.worktrees
/Packages
/*.xcodeproj
Package.pins
*.pem
/docs/1.*
/docs/2.*
Package.resolved
.podspecs
DerivedData
.swiftpm
.*.sw?
# Benchmark baselines embed the host they were measured on, so they are local-only. The committed
# performance record is Examples/PerformanceTester/Thresholds/.
.benchmarkBaselines
